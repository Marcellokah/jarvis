# Copy to .env and fill in. Never commit .env.
#
# Every secret below can live in the macOS Keychain instead of this file —
# env is checked first, then the Keychain:
#
#   security add-generic-password -U -s jarvis -a ICLOUD_APP_PASSWORD -w
#
# (the -w with no value prompts, so the secret never reaches your shell history)

NODE_ENV=development

# --- required -----------------------------------------------------------------
# JARVIS_TOKEN — the bearer token for /api/*.
#
# Deliberately NOT listed as a variable here. `tailscale serve` publishes /api/*
# to the tailnet, and this token is the only thing guarding it; a plaintext file
# is the wrong home for it. It belongs in the Keychain with the other secrets:
#
#   ./scripts/set-secret.sh JARVIS_TOKEN     # openssl rand -hex 32
#
# Setting it as an env var still works (env is checked first) and is fine for
# development and CI — but `npm run smoke` will flag it rather than pass it.

# --- server -------------------------------------------------------------------
# Fastify binds here ONLY. Exposure is handled by:
#   tailscale serve --bg http://127.0.0.1:8787
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8787
JARVIS_DB=./data/jarvis.db

LOG_LEVEL=info
LOG_PRETTY=true

# --- synthesis (free) ---------------------------------------------------------
# Default chain: groq → template. Runs on Groq's free tier — no cost, but it
# needs an API key from console.groq.com. Like the other secrets, it belongs
# in the Keychain, not here:
#
#   ./scripts/set-secret.sh GROQ_API_KEY
#
# Setting it as an env var still works (env is checked first) and is fine for
# development. Until it is set, `template` takes over and the brief still
# arrives.
# GROQ_API_KEY=
# SYNTHESIS_CHAIN=groq,template
#
# The Claude Code subscription path (`claude-code`) is still available if you
# swap it into SYNTHESIS_CHAIN — it needs a one-time, interactive
# `claude setup-token`, whose output is stored as CLAUDE_CODE_OAUTH_TOKEN
# (env or Keychain).
# CLAUDE_CODE_OAUTH_TOKEN=
# CLAUDE_BIN=/home/jarvis/.local/bin/claude   # alapból: $HOME/.local/bin/claude

# --- GitHub (opcionális) ------------------------------------------------------
# Token NÉLKÜL 60 kérés/óra, ami a napi briefhez elég (7 kérés). Token esetén
# 5000/óra. Public repókhoz nem kell hozzá semmilyen scope.
#   github.com → Settings → Developer settings → Personal access tokens
# GITHUB_TOKEN=

# --- Telegram -----------------------------------------------------------------
# Token from @BotFather.  Chat id from @userinfobot — without it, anyone who
# finds the bot can read your calendar and finances.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_CHAT_ID=

# --- iCloud calendar ----------------------------------------------------------
# An APP-SPECIFIC PASSWORD from appleid.apple.com → Sign-In and Security.
# Never your Apple ID password.
# Create a calendar named "Jarvis" in the Naptár app first — Jarvis writes
# only there, never into your real calendars.
# ICLOUD_USERNAME=
# ICLOUD_APP_PASSWORD=
