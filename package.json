{
  "name": "jarvis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal AI assistant — modular morning briefing over HTTP and Telegram",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.ts",
    "dev": "node --env-file-if-exists=.env --watch src/main.ts",
    "brief": "node --env-file-if-exists=.env scripts/brief-cli.ts",
    "seed": "node --env-file-if-exists=.env scripts/seed.ts",
    "smoke": "node --env-file-if-exists=.env scripts/smoke.ts",
    "eval-models": "node --env-file-if-exists=.env scripts/eval-models.ts",
    "import-health": "node --env-file-if-exists=.env scripts/import-health.ts",
    "analyze": "node --env-file-if-exists=.env scripts/analyze.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "telegram:setup": "node --env-file-if-exists=.env scripts/telegram-setup.ts",
    "diagnose-overlap": "node scripts/diagnose-overlap.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@fastify/rate-limit": "^11.2.0",
    "croner": "^10.0.1",
    "fastify": "^5.2.1",
    "grammy": "^1.46.0",
    "ics": "^3.12.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "tsdav": "^2.3.1",
    "yaml": "^2.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
